#!/usr/bin/env python3
# mtl-cert-apply-runner — ROOT oneshot; /var/lib/mtl/shield/queue/*.req kuyrugunu bosaltir.
# GUVENLIK SINIRI: istek dosyasini 'mtl' web servisi yazar; runner root calisir.
# Bu yuzden SADECE whitelist aksiyon + UUID arg kabul edilir; shell YOK, arg-list ile cagrilir.
# Her istek icin: dogrula -> /opt/mtl/bin/mtl-cert-apply <action> <args...> -> <base>.result yaz -> .req sil.
import json, os, re, subprocess, sys, time, glob

QUEUE_DIR = os.environ.get("MTL_QUEUE_DIR", "/var/lib/mtl/shield/queue")
HELPER    = os.environ.get("MTL_CERT_APPLY", "/opt/mtl/bin/mtl-cert-apply")
TIMEOUT   = int(os.environ.get("MTL_RUNNER_TIMEOUT", "120"))
RESULT_TTL= int(os.environ.get("MTL_RESULT_TTL", "3600"))  # yetim .result temizligi (sn)

UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
ARITY = {"activate-server": 1, "activate-ca": 1, "activate-bundle": 2}

def log(*a): print("[runner]", *a, file=sys.stderr)

def write_atomic(path, text, mode=0o644):
    tmp = path + ".wtmp"
    with open(tmp, "w") as f:
        f.write(text); f.flush(); os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)  # ayni dizin -> atomik rename

def write_result(base, rc, stdout, stderr):
    # shield bunu okur: rc + helper stdout (son { satiri). stderr teshis icin.
    payload = json.dumps({"rc": rc, "stdout": stdout, "stderr": stderr[-2000:]}, ensure_ascii=False)
    write_atomic(base + ".result", payload)

def validate(req):
    if not isinstance(req, dict):
        return None, "istek JSON nesnesi degil"
    action = req.get("action")
    args = req.get("args")
    if action not in ARITY:
        return None, f"izinsiz aksiyon: {action!r}"
    if not isinstance(args, list) or len(args) != ARITY[action]:
        return None, f"{action} icin {ARITY[action]} arg bekleniyor"
    for a in args:
        if not (isinstance(a, str) and UUID_RE.match(a)):
            return None, f"gecersiz arg (uuid degil): {a!r}"
    return (action, args), None

def process_one(reqpath):
    base = reqpath[:-4]  # ".req" kes
    try:
        raw = open(reqpath).read()
        req = json.loads(raw)
    except Exception as e:
        log("istek okunamadi/parse:", reqpath, e)
        write_result(base, 2, json.dumps({"ok": False, "message": "istek parse edilemedi"}), str(e))
        os.unlink(reqpath); return
    parsed, err = validate(req)
    if err:
        log("REDDEDILDI:", reqpath, err)
        write_result(base, 2, json.dumps({"ok": False, "message": err}, ensure_ascii=False), "")
        os.unlink(reqpath); return
    action, args = parsed
    log("calistiriliyor:", action, args)
    try:
        proc = subprocess.run([HELPER, action, *args],  # arg-list, shell YOK
                              capture_output=True, text=True, timeout=TIMEOUT, check=False)
        write_result(base, proc.returncode, proc.stdout or "", proc.stderr or "")
        log("bitti rc=", proc.returncode)
    except subprocess.TimeoutExpired as e:
        write_result(base, 124, json.dumps({"ok": False, "message": "helper zaman asimi"}),
                     (e.stderr or b"").decode("utf-8", "replace") if isinstance(e.stderr, bytes) else (e.stderr or ""))
    except Exception as e:
        write_result(base, 1, json.dumps({"ok": False, "message": f"runner hatasi: {e}"}, ensure_ascii=False), str(e))
    finally:
        try: os.unlink(reqpath)
        except FileNotFoundError: pass

def prune_orphans():
    now = time.time()
    for r in glob.glob(os.path.join(QUEUE_DIR, "*.result")):
        try:
            if now - os.path.getmtime(r) > RESULT_TTL:
                os.unlink(r); log("yetim result silindi:", r)
        except FileNotFoundError:
            pass

def main():
    if not os.path.isdir(QUEUE_DIR):
        log("kuyruk dizini yok:", QUEUE_DIR); return 0
    # patlamalar icin: kalan .req olmayana dek don
    for _ in range(50):
        reqs = sorted(glob.glob(os.path.join(QUEUE_DIR, "*.req")))
        if not reqs:
            break
        for r in reqs:
            process_one(r)
    prune_orphans()
    return 0

if __name__ == "__main__":
    sys.exit(main())
